# IMAP-Konten (nummeriert: _0, _1, _2, …)
# Jedes Konto wird in einem eigenen Thread überwacht.
# Fallback: IMAP_HOST (ohne Suffix) für ein einzelnes Konto.
IMAP_HOST_0=imap.example.com
IMAP_PORT_0=993
IMAP_USER_0=konto1@example.com
IMAP_PASSWORD_0=your-imap-password
IMAP_MAILBOX_0=INBOX

# Zweites Konto (optional – bei Bedarf einkommentieren)
# IMAP_HOST_1=imap.other.com
# IMAP_PORT_1=993
# IMAP_USER_1=konto2@other.com
# IMAP_PASSWORD_1=your-imap-password
# IMAP_MAILBOX_1=INBOX

# SMTP (Ausgehende E-Mails) – gleicher Server wie IMAP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-smtp-password
# Optional: Absenderadresse im From-Header, falls abweichend vom SMTP_USER
# (Login erfolgt weiterhin mit SMTP_USER/SMTP_PASSWORD; Provider muss
# das Senden "im Namen von" SMTP_FROM erlauben, sonst greifen SPF/DKIM nicht)
# SMTP_FROM=yourOtherMail@email.com

# LLM-API (OpenAI-kompatibel)
# OpenRouter: https://openrouter.ai/keys
# Together.ai: https://api.together.xyz
# OpenAI:     https://platform.openai.com/api-keys
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# Verfuegbare Qwen-VL Modelle auf OpenRouter (Stand Juni 2026):
# qwen/qwen3-vl-8b-instruct       (klein, kostenguenstig)
# qwen/qwen3-vl-32b-instruct      (besser, moderate Kosten)
# qwen/qwen2.5-vl-72b-instruct    (bewaehrt fuer Rechnungen)
LLM_MODEL=qwen/qwen3-vl-8b-instruct
LLM_MAX_PAGES=3          # 0 = alle Seiten senden
